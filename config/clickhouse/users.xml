<clickhouse>
    <users>
        <admin>
            <password>admin</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </admin>
        <!-- replica_reader mirrors prod inco_reader role - SELECT on read.* only -->
        <replica_reader>
            <password>reader</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>readonly</profile>
            <quota>default</quota>
        </replica_reader>
    </users>
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
            <!-- Tune FINAL performance -->
            <max_threads>4</max_threads>
            <optimize_on_insert>1</optimize_on_insert>
        </default>
        <readonly>
            <readonly>1</readonly>
            <max_memory_usage>5000000000</max_memory_usage>
        </readonly>
    </profiles>
</clickhouse>
